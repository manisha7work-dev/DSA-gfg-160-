//first oocurance -> naive apporch
class Solution {
    int firstOccurence(String txt, String pat) {
        // code here
        int n = txt.length();
        int m = pat.length();
        
        //try evry startering index
        for(int i =0; i<=n-m ; i++){
            
            int j;
            //compare pattern charcters
            for(j =0; j< m; j++){
                if(txt.charAt(i+j)!= pat.charAt(j)){
                    break;
                }
            }
            //if pattern matched
            if( j == m){
                return i;
            }
        }
        return -1;
        
    }
}
